## Encryption Key
CONFIG_encryption_key=

## App Details
APP_NAME=URstore
DOMAIN=localhost

## DataBase Default
DB_HOST=localhost
DB_DATABASE=v2_urstore
DB_USERNAME=root
DB_PASSWORD=

## Session/Cache Driver
SESS_DRIVER=
SESS_COOKIE_NAME=
SESS_EXPIRATION=
SESS_SAVE_PATH=
SESS_MATCH_IP=
SESS_TIME_TO_UPDATE=
SESS_REGENERATE_DESTROY=
SESS_SAMESITE=Lax

## WebSocket Server
# WS_PORT:       The port Ratchet listens on (Apache proxies this)
# WS_ADMIN_PORT: Internal-only HTTP port for CI → WS server push notifications
# WS_PUBLIC_URL: The URL the browser uses to connect (ws:// or wss://)
#                For subfolder installs (DOMAIN=host/path): ws://host/path/ws
#                For SSL: wss://yourdomain.com/ws
# WS_LOG_FILE:   Absolute path to the WS server's log file
WS_PORT=8080
WS_ADMIN_PORT=8081
WS_PUBLIC_URL=ws://localhost:8080
WS_LOG_FILE=/var/www/html/web-rtc/application/logs/websocket.log