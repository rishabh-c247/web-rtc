Options -Indexes

RewriteEngine On

# Serve uploads directly (no CI routing needed for static assets)
RewriteRule ^uploads/(.*)$ uploads/$1 [L]

# Route everything else through CI's index.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php/$1 [L]
